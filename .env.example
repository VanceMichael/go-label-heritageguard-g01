HERITAGEGUARD_ADDR=:8080
HERITAGEGUARD_DATABASE=/data/heritageguard.db
HERITAGEGUARD_SESSION_TTL=8h
HERITAGEGUARD_WORKER_INTERVAL=500ms
HERITAGEGUARD_SHUTDOWN_TIMEOUT=10s
HERITAGEGUARD_LOG_LEVEL=info
HERITAGEGUARD_MAX_OPEN_CONNS=8
HERITAGEGUARD_SENSOR_SECRET=replace-with-a-random-sensor-secret
HERITAGEGUARD_OUTBOX_ENDPOINT=
HERITAGEGUARD_BOOTSTRAP_TENANT=museum-demo
HERITAGEGUARD_BOOTSTRAP_EMAIL=supervisor@example.invalid
HERITAGEGUARD_BOOTSTRAP_NAME=HeritageGuard Supervisor
HERITAGEGUARD_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
